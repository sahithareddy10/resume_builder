# ═══════════════════════════════════════════════════════════════
# AI Resume Optimizer — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── Model Configuration (REQUIRED — set these!) ────────────────
# HuggingFace model ID or local path to your model
MODEL_NAME=/

# Absolute path to your trained QLoRA/LoRA adapter weights directory
MODEL_ADAPTER_PATH=

# Device: cuda | cpu | mps (Apple Silicon)
DEVICE=cuda

# ── Generation Parameters ───────────────────────────────────────
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
MODEL_TIMEOUT=120

# Fine-tuned local model (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=resume-optimizer

# ── API ─────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── File Storage ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=10

# ── Redis (optional — for async task queue) ─────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
USE_CELERY=false

# ── Security ────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
